---
// Pill button. Renders an <a> when `href` is set, otherwise a <button>.
// `disabled` forces the non-interactive, visibly-disabled state used by the
// coming-soon catalog CTA (no href, no navigation — AC5).
interface Props {
  variant?: "primary" | "secondary" | "ghost";
  href?: string;
  disabled?: boolean;
  size?: "md" | "lg";
  class?: string;
}
const {
  variant = "primary",
  href,
  disabled = false,
  size = "md",
  class: className = "",
} = Astro.props;

const base =
  "inline-block text-center font-bold rounded-full transition-all duration-300";

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-8 py-4 text-lg",
};

const variants = {
  primary:
    "bg-green-500 hover:bg-green-600 text-white shadow-md hover:shadow-lg transform hover:-translate-y-1 hover:scale-105",
  secondary:
    "bg-white hover:bg-gray-50 text-gray-800 border-2 border-gray-200 shadow-xs hover:shadow-md",
  ghost: "bg-gray-100 hover:bg-gray-200 text-gray-900",
};

const disabledClasses = "bg-gray-100 text-gray-400 cursor-not-allowed opacity-70";

const classes = [
  base,
  sizes[size],
  disabled ? disabledClasses : variants[variant],
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  disabled ? (
    <button type="button" disabled class={classes} aria-disabled="true">
      <slot />
    </button>
  ) : (
    <a href={href} class={classes}>
      <slot />
    </a>
  )
}
