---
// Footer logo: detailed multi-circle panda face. Body uses currentColor; the
// eyes/snout/ears are fixed white/black per the source.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle cx="16" cy="16" r="14" fill="currentColor" class="[color:currentColor]"></circle>
  <circle cx="11.5" cy="12" r="2.25" fill="white"></circle>
  <circle cx="20.5" cy="12" r="2.25" fill="white"></circle>
  <circle cx="16" cy="17" r="3" fill="white"></circle>
  <circle cx="14.7" cy="16.8" r="0.9" fill="black"></circle>
  <circle cx="17.3" cy="16.8" r="0.9" fill="black"></circle>
  <path
    d="M13.5 21.2C14.4 22.3 15.2 22.8 16 22.8C16.8 22.8 17.6 22.3 18.5 21.2"
    stroke="black"
    stroke-width="1.6"
    stroke-linecap="round"></path>
  <circle cx="9" cy="8" r="3" fill="currentColor" class="[color:currentColor]"></circle>
  <circle cx="23" cy="8" r="3" fill="currentColor" class="[color:currentColor]"></circle>
</svg>
