---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ProductCard from "../components/ProductCard.astro";
import Button from "../components/Button.astro";
import HeartIcon from "../components/icons/HeartIcon.astro";
import BoltIcon from "../components/icons/BoltIcon.astro";
import SmileIcon from "../components/icons/SmileIcon.astro";
import ArrowIcon from "../components/icons/ArrowIcon.astro";
import heroPanda from "../assets/playgrounds/hero_panda.jpeg";
import rolyPoly from "../assets/playgrounds/roly_poly_slide.jpeg";

// Featured = the available products, collection-sourced (no hardcoded data).
const featured = (await getCollection("playgrounds"))
  .filter((p) => p.data.status === "available")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="PandaPlay - Build a Paradise for Pandas"
  description="We design and build specialized, enrichment-focused playgrounds that keep giant pandas happy, active, and thriving in sanctuaries worldwide."
>
  {/* Hero */}
  <header class="relative pt-16 pb-24 lg:pt-24 lg:pb-32 overflow-hidden bg-pink-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center text-center">
      <h1
        data-hide
        class="reveal font-display text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 tracking-tight mb-6"
      >
        Build a Paradise<br class="hidden md:block" /> for Pandas
      </h1>
      <p data-hide class="reveal text-lg md:text-xl text-gray-600 max-w-2xl mb-10 leading-relaxed">
        We design and build specialized, enrichment-focused playgrounds that keep giant pandas
        happy, active, and thriving in sanctuaries worldwide.
      </p>
      <div data-hide class="reveal flex flex-col sm:flex-row gap-4 mb-16">
        <Button href="/catalog" variant="primary" size="lg" class="shadow-lg hover:shadow-xl">
          Browse Playground Catalog
        </Button>
        <Button href="#why-play" variant="secondary" size="lg">Learn More</Button>
      </div>
      <div data-hide class="reveal w-full max-w-5xl rounded-[3rem] overflow-hidden shadow-2xl relative">
        <div class="absolute inset-0 bg-green-900/10 mix-blend-multiply rounded-[3rem]"></div>
        <Image
          src={heroPanda}
          alt="Cute panda playing in meadow"
          width={1600}
          height={1200}
          class="w-full h-auto object-cover md:h-[600px] transform hover:scale-105 transition-transform duration-700"
        />
      </div>
    </div>
    {/* Decorative blobs */}
    <div
      class="absolute top-0 left-0 w-96 h-96 bg-green-100 rounded-full mix-blend-multiply filter blur-3xl opacity-70 -translate-x-1/2 -translate-y-1/2"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 w-[30rem] h-[30rem] bg-pink-100 rounded-full mix-blend-multiply filter blur-3xl opacity-70 translate-x-1/3 translate-y-1/3"
    >
    </div>
  </header>

  {/* Why Play Matters */}
  <section id="why-play" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Why Play Matters"
        subtitle="Giant pandas naturally spend hours foraging, climbing, and exploring. Our enrichment playgrounds stimulate their natural behaviors, ensuring they stay physically fit and mentally sharp."
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <FeatureCard
          title="Physical Health"
          body="Climbing structures and dynamic terrain prevent obesity and build strong muscles crucial for their well-being."
          iconBg="bg-green-100"
          iconColor="text-green-600"
          rotation="-rotate-6"
          hoverBg="hover:bg-green-50"
        >
          <HeartIcon class="w-10 h-10" />
        </FeatureCard>
        <FeatureCard
          title="Mental Stimulation"
          body="Puzzle feeders and complex layouts challenge their intelligence, reducing stress and boredom in captivity."
          iconBg="bg-amber-100"
          iconColor="text-amber-600"
          rotation="rotate-3"
          hoverBg="hover:bg-amber-50"
          delay="delay-100"
        >
          <BoltIcon class="w-10 h-10" />
        </FeatureCard>
        <FeatureCard
          title="Joyful Living"
          body="Simply put, playing makes them happy! A happy panda is more active and has better overall health outcomes."
          iconBg="bg-pink-100"
          iconColor="text-pink-500"
          rotation="-rotate-3"
          hoverBg="hover:bg-pink-50"
          delay="delay-200"
        >
          <SmileIcon class="w-10 h-10" />
        </FeatureCard>
      </div>
    </div>
  </section>

  {/* Featured Playgrounds */}
  <section id="catalog" class="py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12">
        <div class="max-w-2xl">
          <h2 data-hide class="reveal font-display text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            Featured Playgrounds
          </h2>
          <p data-hide class="reveal text-lg text-gray-600">
            Discover our most popular installations loved by pandas and caretakers alike.
          </p>
        </div>
        <div data-hide class="reveal mt-6 md:mt-0">
          <a href="/catalog" class="inline-flex items-center text-green-600 font-bold hover:text-green-700 transition">
            View Full Catalog
            <ArrowIcon class="ml-2 w-5 h-5" />
          </a>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          featured.map((entry, i) => (
            <ProductCard entry={entry} badgePlacement="inline" delay={i === 1 ? "delay-100" : ""} />
          ))
        }
      </div>
    </div>
  </section>

  {/* Sanctuary Spotlight */}
  <section id="sanctuaries" class="py-24 bg-pink-50 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-white rounded-[3rem] p-10 md:p-16 shadow-xl flex flex-col md:flex-row items-center gap-12">
        <div data-hide class="reveal flex-1 w-full order-2 md:order-1">
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-green-100 h-48 rounded-3xl border-4 border-white shadow-xs transform -rotate-3 overflow-hidden">
              <Image src={heroPanda} alt="Panda partial" width={400} height={400} class="w-full h-full object-cover" />
            </div>
            <div
              class="bg-amber-100 h-48 rounded-3xl border-4 border-white shadow-xs transform rotate-6 translate-y-6 overflow-hidden"
            >
              <Image src={rolyPoly} alt="Panda sliding" width={400} height={400} class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
        <div class="flex-1 order-1 md:order-2">
          <span data-hide class="reveal text-pink-600 font-bold tracking-wider uppercase text-sm mb-2 block">
            Sanctuary Spotlight
          </span>
          <h2 data-hide class="reveal font-display text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Supporting Global Conservation
          </h2>
          <p data-hide class="reveal text-lg text-gray-600 mb-8 leading-relaxed">
            Every playground we install is built in collaboration with wildlife experts. We work
            directly with non-profit sanctuaries to ensure our designs meet the exact behavioral
            needs of rescued and breeding pandas, contributing to successful conservation efforts
            worldwide.
          </p>
          <Button href="#" variant="pink" size="lg" class="reveal" data-hide>
            Learn More About Our Sanctuaries
          </Button>
        </div>
      </div>
    </div>
    {/* Decorative blob */}
    <div
      class="absolute bottom-0 left-0 w-[40rem] h-[40rem] bg-pink-200 rounded-full mix-blend-multiply filter blur-[100px] opacity-60 -translate-x-1/3 translate-y-1/3"
    >
    </div>
  </section>
</BaseLayout>
